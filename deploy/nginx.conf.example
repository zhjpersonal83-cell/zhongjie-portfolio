# EXAMPLE ONLY: no server has been configured or deployed by this project.
# Include this snippet from an nginx http {} context after confirming existing hosts.
# Retain a complete mime.types include in the enclosing http {} configuration.
# Replace the domain, path and listener; use the server's actual HTTPS/TLS setup.

map $uri $portfolio_cache_control {
    default                                 "public, max-age=3600";
    ~*[.-][0-9a-f]+\.(css|js)$               "public, max-age=31536000, immutable";
    ~*(/|\.html)$                            "no-cache";
    ~*/(robots\.txt|sitemap\.xml|manifest\.webmanifest|VERSION\.txt)$ "no-cache";
}

server {
    # HTTP routing example. Add to your established HTTPS host in production.
    listen 80;
    server_name www.zhongjiehuang.com;

    # This is a placeholder path to the generated site, not the project root.
    root /srv/www/zhongjie-portfolio/current/site;
    index index.html;
    charset utf-8;
    default_type application/octet-stream;
    autoindex off;
    etag on;

    # Keep these on the same configuration level. If a location adds add_header,
    # repeat/merge the intended headers there according to your nginx version.
    add_header Cache-Control $portfolio_cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    # Deliberately scoped CSP: it does not block inline JSON-LD or style changes.
    # A stricter script/style policy needs hashes/nonces and browser validation.
    add_header Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    error_page 404 /404.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /404.html {
        internal;
    }

    # Static hosts do not automatically protect Java application metadata.
    location ~* ^/(WEB-INF|META-INF)(/|$) {
        return 404;
    }

    # Preserve ACME /.well-known/ routing if this host uses certificate renewal.
    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }
}
